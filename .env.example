RADARR_URL=http://192.168.1.50:7878
RADARR_API_KEY=changeme
RADARR_DRY_RUN=1
MAX_STEPS=12
# Fixed access token for web.py (optional; random per start if unset)
# SMOLPAW_WEB_TOKEN=
# Search provider: ddgs (default, no setup needed), searxng, or none (disables the tool)
# SMOLPAW_SEARCH_PROVIDER=ddgs
# SearXNG instance URL (required if SMOLPAW_SEARCH_PROVIDER=searxng)
# SMOLPAW_SEARCH_URL=http://localhost:8080
